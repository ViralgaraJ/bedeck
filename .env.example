APP_NAME="Bedeck International"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- MySQL (create the DB + user in cPanel > MySQL Databases) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_bedeck
DB_USERNAME=cpaneluser_bedeck
DB_PASSWORD=your-strong-db-password

# File-based drivers keep shared hosting simple (no extra tables / Redis needed)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---- Email: use the cPanel mailbox for this domain ----
MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_USERNAME=info@your-domain.com
MAIL_PASSWORD=your-mailbox-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@bedeckinternational.lk"
MAIL_FROM_NAME="${APP_NAME}"

# ---- First admin account (created by: php artisan db:seed --class=AdminUserSeeder) ----
ADMIN_NAME="Bedeck Admin"
ADMIN_EMAIL="admin@bedeckinternational.lk"
ADMIN_PASSWORD="change-this-now"
